---
import { nav, site } from '@/data/site';
import { pillars, productsOf, productUrl } from '@/data/catalog';
const path = Astro.url.pathname;
---
<header class="hdr" data-hdr>
  <div class="hdr-in wrap">
    <a href="/" class="brand" aria-label="Gen.Health, inicio">
      <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="18" />
        <circle cx="20" cy="20" r="11.1" />
        <path d="M20 2a18 18 0 0 1 0 36" />
        <circle class="core" cx="20" cy="20" r="3" />
      </svg>
      <span class="brand-word">Gen<span class="dot">.</span>Health</span>
    </a>

    <nav class="hdr-nav" aria-label="Principal">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} class:list={['link-u', { on: path.startsWith(n.href) }]}>{n.label}</a></li>
        ))}
      </ul>
    </nav>

    <a href="/contacto/" class="hdr-cta">Hablemos</a>

    <button class="burger" type="button" aria-expanded="false" aria-controls="menu" data-burger>
      <span class="sr-only">Abrir menú</span>
      <i></i><i></i>
    </button>
  </div>
</header>

<div class="menu theme-dark" id="menu" data-menu hidden>
  <div class="menu-in wrap">
    <p class="t-mono soft">Índice · Gen.Health</p>
    <ol class="menu-list">
      {pillars.map((p) => (
        <li class="menu-item">
          <a href={`/${p.slug}/`} class="menu-link">
            <span class="t-mono accent">{p.index}</span>
            <span class="menu-name">{p.name}</span>
          </a>
          <ul class="menu-sub">
            {productsOf(p.slug).map((x) => <li><a href={productUrl(x)}>{x.name}</a></li>)}
          </ul>
        </li>
      ))}
      <li class="menu-item">
        <a href="/casos/" class="menu-link"><span class="t-mono accent">06</span><span class="menu-name">Casos</span></a>
      </li>
      <li class="menu-item">
        <a href="/nosotros/" class="menu-link"><span class="t-mono accent">07</span><span class="menu-name">Nosotros</span></a>
      </li>
    </ol>
    <div class="menu-foot">
      <a class="btn" href="/contacto/">Agendar una reunión</a>
      <a class="t-mono soft" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
    </div>
  </div>
</div>

<style>
  .hdr {
    position: fixed; inset: 0 0 auto 0; z-index: 100;
    height: var(--header-h);
    color: var(--ink);
    transition: transform 0.6s var(--ease), color 0.4s, background-color 0.4s;
  }
  :global(body[data-header='dark']) .hdr:not(.is-scrolled) { color: #eef3e2; }
  .hdr.is-scrolled {
    background: color-mix(in oklab, var(--paper) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    box-shadow: 0 1px 0 var(--line);
  }
  .hdr.is-hidden { transform: translateY(-100%); }
  .hdr-in { height: 100%; display: flex; align-items: center; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 760; letter-spacing: -0.04em; font-size: 1.3rem; }
  .brand-mark { width: 30px; height: 30px; }
  .brand-mark circle, .brand-mark path { fill: none; stroke: currentColor; stroke-width: 1.6; }
  .brand-mark .core { fill: var(--spark); stroke: none; }
  .brand-word .dot { color: var(--spark); }
  .hdr-nav { margin-left: auto; display: none; }
  .hdr-nav ul { display: flex; gap: clamp(14px, 1.8vw, 30px); }
  .hdr-nav a { font-size: 0.92rem; font-weight: 520; letter-spacing: -0.01em; padding-block: 4px; }
  .hdr-nav a.on { background-size: 100% 1px; }
  .hdr-cta {
    display: none; padding: 10px 18px; border-radius: 999px;
    box-shadow: inset 0 0 0 1px currentColor; font-weight: 600; font-size: 0.92rem;
    transition: background-color 0.3s, color 0.3s;
  }
  .hdr-cta:hover { background: var(--chloro); color: var(--ink); box-shadow: none; }
  .burger { margin-left: auto; width: 44px; height: 44px; display: grid; place-content: center; gap: 7px; position: relative; z-index: 2; }
  .burger i { display: block; width: 26px; height: 1.6px; background: currentColor; transition: transform 0.5s var(--ease); }
  .burger[aria-expanded='true'] i:first-of-type { transform: translateY(4.3px) rotate(45deg); }
  .burger[aria-expanded='true'] i:last-of-type { transform: translateY(-4.3px) rotate(-45deg); }
  :global(html.menu-open) .hdr { color: #eef3e2; background: transparent; box-shadow: none; backdrop-filter: none; }

  @media (min-width: 1100px) {
    .hdr-nav, .hdr-cta { display: block; }
    .burger { margin-left: 0; }
  }

  .menu {
    position: fixed; inset: 0; z-index: 99; overflow-y: auto;
    padding-top: calc(var(--header-h) + 24px); padding-bottom: 40px;
    clip-path: circle(0% at calc(100% - 40px) 36px);
  }
  .menu[hidden] { display: block; visibility: hidden; }
  .menu-in { display: flex; flex-direction: column; gap: 28px; min-height: 100%; }
  .menu-list { display: grid; gap: 4px; }
  .menu-item { border-top: 1px solid var(--rule); padding-block: 12px; }
  .menu-link { display: flex; gap: 16px; align-items: baseline; }
  .menu-name { font-weight: 760; font-size: clamp(2rem, 7vw, 4.6rem); letter-spacing: -0.05em; line-height: 0.95; }
  .menu-link:hover .menu-name { color: var(--chloro); }
  .menu-sub { display: flex; flex-wrap: wrap; gap: 6px 18px; padding: 10px 0 0 36px; }
  .menu-sub a { font-size: 0.95rem; color: var(--fg-soft); }
  .menu-sub a:hover { color: var(--fg); }
  .menu-foot { margin-top: auto; display: flex; flex-wrap: wrap; gap: 20px; align-items: center; }
</style>
