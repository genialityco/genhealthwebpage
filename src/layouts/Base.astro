---
import '@/styles/global.css';
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: Record<string, unknown>[];
  /** Tema de la cabecera sobre el primer bloque. */
  headerTone?: 'light' | 'dark';
}

const { title, description, image, jsonLd, headerTone = 'light' } = Astro.props;
---
<!doctype html>
<html lang="es-CO" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b2219" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <SEO title={title} description={description} image={image} jsonLd={jsonLd} />
  </head>
  <body data-header={headerTone}>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    <div class="curtain" aria-hidden="true">
      <svg viewBox="0 0 100 100" preserveAspectRatio="none"><path class="curtain-path" d="M0 100 C 30 100 70 100 100 100 L100 100 L0 100Z" /></svg>
      <span class="curtain-mark t-mono">Gen.Health · Lámina siguiente</span>
    </div>

    <div class="cursor" aria-hidden="true">
      <svg viewBox="-22 -22 44 44">
        <circle class="ring" r="18" />
        <path d="M-26 0h8M18 0h8M0 -26v8M0 18v8" />
        <circle class="dot" r="2" />
      </svg>
      <span class="cursor-label"></span>
    </div>

    <script>
      import { boot } from '@/scripts/app';
      boot();
    </script>
  </body>
</html>

<style is:global>
  .curtain {
    position: fixed; inset: 0; z-index: 150; pointer-events: none;
  }
  .curtain svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .curtain-path { fill: var(--ink); }
  .curtain-mark {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    color: var(--chloro); opacity: 0;
  }
</style>
